# =====================================================
# .gitignore for AI Test Management Platform
# Upgraded: 2026-09-21
# Goal: keep repo small, safe, and cloneable.
# =====================================================

# ---------- Environment & secrets ----------
# CRITICAL: never commit real credentials
.env
.env.*
!.env.example
.env.bak
.env.local
.env.*.local

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
venv-*/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.cache
coverage.xml
*.cover

# mypy / ruff
.mypy_cache/
.ruff_cache/

# ---------- Django ----------
*.sqlite3
*.sqlite3-journal
local_settings.py
media/
staticfiles/
celerybeat-schedule/.

# ---------- Node / Vue 2 / Webpack ----------
node_modules/
dist/
.npm
.eslintcache
.npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# ---------- Frontend build artifacts ----------
# aitestpage is a Vue 2 + Webpack 3 project; build output goes to dist/
aitestpage/dist/

# ---------- IDE / OS ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.lnk

# ---------- Logs ----------
logs/
*.log
nohup.out
celery_*.log
gunicorn_*.log

# ---------- Runtime artifacts (do NOT push test data) ----------
# Screenshots from interface test runs (may contain business data)
aitestapp/screenshot/

# Records (UI automation test screenshots, 248 files in this repo)
aitestapp/record/

# ---------- Business data ----------
# Interface docs may contain customer names / API secrets
aitestapp/interface_file/
*.docx
!aitestapp/scripts/**/*.docx

# ---------- Vector store & models ----------
# FAISS index files (large, binary, project-specific data)
vectorsFrame/
data/vector_store/
*.faiss
*.index
*.bin
*.pt
*.pth
*.safetensors
lora_output/
checkpoints/

# ---------- Redis ----------
dump.rdb
*.rdb

# ---------- Docker ----------
.docker/

# ---------- Backups ----------
*.bak
*.bak.*
*.orig
*.rej
*.tmp
*~
*.swp

# ---------- Generated by Django migrations (keep migrations/, just ignore __pycache__) ----------
# (already covered by __pycache__/ above)
# ============================================
# AI Test Platform - 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ============================================

# --------------------------------------------
# Django 基础配置
# --------------------------------------------
# Django 密钥（必填，使用 python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())' 生成）
DJANGO_SECRET_KEY=your-secret-key-here

# 调试模式（生产环境设为 False）
DJANGO_DEBUG=False

# 允许的主机（生产环境设置实际域名，多个用逗号分隔）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --------------------------------------------
# 数据库配置 (MySQL)
# --------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aitest_db
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password

# --------------------------------------------
# Redis 配置 (Celery 缓存/消息队列)
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --------------------------------------------
# 智谱AI API (ZhiPu AI GLM-4)
# --------------------------------------------
# 从 https://open.bigmodel.cn/ 获取 API Key
ZHIPUAI_API_KEY=your-zhipuai-api-key-here

# --------------------------------------------
# AES 加密配置
# --------------------------------------------
# AES-256-CBC 加密密钥（必须为16/24/32字符）
# 使用 python -c "import secrets; print(secrets.token_hex(16))" 生成
AES_ENCRYPTION_KEY=your-aes-encryption-key-here-16b

# --------------------------------------------
# 文件存储路径
# --------------------------------------------
# 媒文件根目录（默认项目下 media 目录）
MEDIA_ROOT=/path/to/project/media

# 数据目录（用于 FAISS 向量索引等）
DATA_DIR=/path/to/project/data

# FAISS 向量索引路径
FAISS_INDEX_PATH=/path/to/faiss/index

# --------------------------------------------
# 测试环境 URL
# --------------------------------------------
# 接口测试目标基础URL
TEST_URL=http://your-test-server:port

# --------------------------------------------
# 前端构建配置 (Vue.js)
# --------------------------------------------
# 前端 AES 密钥（需与后端 AES_ENCRYPTION_KEY 保持一致）
VUE_APP_AES_KEY=your-vue-aes-key-here-16b
VUE_APP_AES_IV=your-vue-aes-iv-here-16b

# API 基础地址
VUE_APP_API_BASE_URL=http://localhost:8000
